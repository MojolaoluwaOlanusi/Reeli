# Set one server-only TMDB credential. Do not prefix either with VITE_.
TMDB_API_READ_ACCESS_TOKEN=
# Alternative to the read access token:
TMDB_API_KEY=

# Public Appwrite client settings; needed only for Google sign-in.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=